# SkillForge server environment (copy to .env and adjust).
# Every SKILLFORGE_* variable read by packages/server/src/config.ts is listed here.

# HTTP listen port (integer > 0). Default: 8787
SKILLFORGE_PORT=8787

# Bind address. Use 0.0.0.0 inside Docker. Default: 127.0.0.1
SKILLFORGE_HOST=0.0.0.0

# Absolute or relative path for SQLite DB + blobs + backups. In Docker: /data
SKILLFORGE_DATA_DIR=/data

# Public base URL (cookies Secure when https). Default: http://<host>:<port>
SKILLFORGE_BASE_URL=http://localhost:8787

# Optional override for the built SPA directory. Default: packages/web/dist next to server
# SKILLFORGE_WEB_DIR=

# Folder the registry serves the CLI package from (/downloads/skillforge-cli.tgz). Default: downloads/ in the install root.
# SKILLFORGE_DOWNLOADS_DIR=

# Initial admin password when the DB is empty. Empty/unset generates a random one.
# SKILLFORGE_ADMIN_PASSWORD=

# Anonymous GET of catalog APIs: true|false|1|0. Default: true
SKILLFORGE_PUBLIC_READ=true

# Session TTL in days (1-365), sliding. Default: 30
SKILLFORGE_SESSION_TTL_DAYS=30

# Days without validation before active -> aging. Default: 90
SKILLFORGE_AGING_DAYS=90

# Days a candidate may sit before aging rules apply. Default: 30
SKILLFORGE_CANDIDATE_TTL_DAYS=30

# Data-based lifecycle automation: on|off. Default: on
SKILLFORGE_DATA_LIFECYCLE=on

# Days of inactivity before aging -> zombie (idle rule). Default: 180
SKILLFORGE_ZOMBIE_IDLE_DAYS=180

# Usage-report window days for low_transfer. Default: 60
SKILLFORGE_ZOMBIE_WINDOW_DAYS=60

# Min capped uses in window before low_transfer applies. Default: 20
SKILLFORGE_ZOMBIE_MIN_USES=20

# Min distinct reporters for low_transfer. Default: 3
SKILLFORGE_ZOMBIE_MIN_REPORTERS=3

# Transfer-rate threshold (0..1) for low_transfer. Default: 0.2
SKILLFORGE_ZOMBIE_TRANSFER_RATE=0.2

# Days in zombie before cleanup suggests retire. Default: 30
SKILLFORGE_ZOMBIE_RETIRE_DAYS=30

# Min ablation tasks for no_ablation_uplift. Default: 10
SKILLFORGE_ABLATION_MIN_TASKS=10
# Path to JSON file of eval runners (optional; without it POST /evals/runs returns 503).
# SKILLFORGE_EVAL_RUNNERS_FILE=

# Parallel case executions inside one eval run (1..8). Default: 2
SKILLFORGE_EVAL_CONCURRENCY=2

# Max eval runs per artifact per UTC day (>=1). Default: 20
SKILLFORGE_EVAL_MAX_RUNS_PER_DAY=20

# Auto-run an ablation eval batch on every published skill version (needs
# SKILLFORGE_EVAL_RUNNERS_FILE and a task case in the artifact's suite).
# Children consume the daily eval run limit. true|false|1|0. Default: false
SKILLFORGE_EVAL_ABLATION_AUTO=false

# Revive window days (aging -> active by usage). Default: 14
SKILLFORGE_REVIVE_WINDOW_DAYS=14

# Min usage events in revive window. Default: 3
SKILLFORGE_REVIVE_MIN_EVENTS=3

# Max automatic lifecycle transitions per sweep. Default: 20
SKILLFORGE_LIFECYCLE_MAX_PER_SWEEP=20
# Allow git import sources: true|false|1|0. Default: true
SKILLFORGE_IMPORT_GIT=true

# Allow file:// git URLs (local only): true|false|1|0. Default: false
SKILLFORGE_IMPORT_ALLOW_FILE_URLS=false

# Import session TTL in minutes (1-120). Default: 15
SKILLFORGE_IMPORT_TTL_MINUTES=15

# Marketplace plugin name (kebab-case). Default: skillforge
SKILLFORGE_MARKETPLACE_NAME=skillforge

# Marketplace owner display string. Default: SkillForge
SKILLFORGE_MARKETPLACE_OWNER=SkillForge

# How marketplace.json points Claude Code (>= 2.1.288) at a plugin: auto | archive | command. Default: auto.
# archive = zip + sha256 (needs an https:// SKILLFORGE_BASE_URL that is not localhost/loopback);
# command = Claude Code runs `skillforge plugin-dir ...` (the CLI must be on the client's PATH).
# auto = archive when the base URL allows it, otherwise command. A mismatch with the base URL refuses startup.
SKILLFORGE_MARKETPLACE_SOURCE=auto

# How many backup archives to keep in <data_dir>/backups (integer >= 1). Default: 10
SKILLFORGE_BACKUP_KEEP=10

# Directory with SkillForge plugins (default: <data_dir>/plugins)
# SKILLFORGE_PLUGINS_DIR=
# SKILLFORGE_BUNDLED_PLUGINS_DIR=
# SKILLFORGE_MIRROR_INTERVAL_HOURS=24

# Disable plugin loading entirely: true|false|1|0. Default: false
SKILLFORGE_PLUGINS_DISABLED=false

# Semicolon- or colon-separated directories on the server that may host admin "server" agents.
# Empty (default) disables POST /api/v1/admin/agents with 403 agent_roots_disabled.
# On Windows use semicolons so drive letters are preserved (C:\agents;D:\runners).
# SKILLFORGE_AGENT_ROOTS=

# Directory of vendored starter packs (default: packages/server/starter-packs next to the server package).
# SKILLFORGE_STARTER_PACKS_DIR=

# Log level for request/app logs: error|warn|info|debug. Default: info
# SKILLFORGE_LOG_LEVEL=info

# Days to keep run outputs before the sweeper deletes them (0 = keep forever). Default: 30
# SKILLFORGE_RUN_OUTPUT_RETENTION_DAYS=30

# Max bytes stored per run-output stream; larger output is truncated. Default: 1048576 (1 MiB)
# SKILLFORGE_RUN_OUTPUT_MAX_BYTES=1048576

# Orchestration surface (workflows, routines, hook runtime APIs + routines
# scheduler) — OFF by default. true|false|1|0; true or 1 enables; operator-only,
# there is no API toggle. When off, orchestration endpoints answer 403 feature_disabled.
# SKILLFORGE_ORCHESTRATION_ENABLED=

# Global kill switch for the routines scheduler: true|false|1|0. Default: false.
# true or 1 = no new scheduled fires (manual runs still work). Read at startup.
# SKILLFORGE_ROUTINES_DISABLED=

# Global kill switch for the hook runtime: true|false|1|0. Default: false.
# true or 1 = evaluations return allow without executing or auditing entries.
# Read at startup.
# SKILLFORGE_HOOKS_DISABLED=

# Production error mode (500 responses hide internal error text): true|false|1|0.
# Default: false; NODE_ENV=production turns it on regardless.
# SKILLFORGE_SAFE_ERRORS=

# Default per-entry timeout in seconds for hook command execution when the
# entry has no own timeout. Integer 1..600. Default: 10
# SKILLFORGE_HOOK_TIMEOUT_S=10

# Auth mode: password (default) or local (single-user loopback only).
# SKILLFORGE_AUTH_MODE=password

# Public origin for OIDC redirect URIs (required when any OIDC provider is set).
# Example: https://skillforge.example.com
# SKILLFORGE_PUBLIC_URL=

# OIDC providers JSON array: [{ id, label, issuer, client_id, client_secret, scopes?, role_claim?, role_map?, default_role? }]
# id must be kebab-case. Secrets must never be logged or returned by the API.
# SKILLFORGE_OIDC_PROVIDERS=

# Google OIDC preset (adds provider id=google). Both must be set together.
# SKILLFORGE_GOOGLE_CLIENT_ID=
# SKILLFORGE_GOOGLE_CLIENT_SECRET=

# LDAP / Active Directory providers JSON array:
# [{ id, label, url, bind_dn, bind_password, user_base, user_filter, username_attribute?, display_name_attribute?, email_attribute?, group_attribute?, role_map?, default_role?, timeout_ms?, tls_ca_file? }]
# user_filter must contain {username}; id must be unique across OIDC + LDAP providers.
# SKILLFORGE_LDAP=

# Help assistant (llm-help-assistant). API key of the OpenAI-compatible LLM; never stored, returned or logged.
# Other settings (address, model, limits) are edited by an admin at /admin/assistant. Local servers need no key.
# SKILLFORGE_LLM_API_KEY=
# Origins the key may be sent to, comma-separated (e.g. https://api.openai.com,http://localhost:11434).
# Unset = the key is never sent; an invalid value stops the server at startup.
# SKILLFORGE_LLM_KEY_ORIGINS=
# Agent Space budget broker (llm-budget-broker): absolute path of its Unix socket; every model call goes through it.
# SKILLFORGE_BUDGET_SOCKET=

# Rollout through pull requests and rules from reviews (pr-rollout, skill-harvest). GitHub token: only from the
# environment, sent only to SKILLFORGE_GITHUB_API_URL, never stored or returned. Unset = both features answer 503.
# SKILLFORGE_GITHUB_TOKEN=
# GitHub REST API; for GitHub Enterprise https://<host>/api/v3. https only (http only for loopback).
# SKILLFORGE_GITHUB_API_URL=https://api.github.com

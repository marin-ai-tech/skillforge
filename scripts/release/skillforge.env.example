# SkillForge settings: NAME=value per line. See INSTALL.md and the in-app help /help/getting-started/self-hosting;
# every variable is listed in docs/en/03-self-hosting.md of the SkillForge repository (not in this archive).
SKILLFORGE_PORT=8080
# 127.0.0.1 — this machine only; 0.0.0.0 — every network interface.
SKILLFORGE_HOST=127.0.0.1
SKILLFORGE_DATA_DIR=./data
# Public address of the registry when it sits behind a proxy or a DNS name:
# SKILLFORGE_BASE_URL=https://skillforge.example.com
# Password of the first admin; when empty a random one is written to <data>/initial-admin-password.txt:
# SKILLFORGE_ADMIN_PASSWORD=

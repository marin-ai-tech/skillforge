{
  "$schema": "https://json.schemastore.org/claude-code-hooks.json",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          { "type": "command", "command": "\"${CLAUDE_PLUGIN_ROOT}\"/scripts/guard.sh", "timeout": 10 }
        ]
      }
    ],
    "Stop": [
      { "hooks": [ { "type": "prompt", "prompt": "Confirm no destructive command was left running." } ] }
    ]
  }
}

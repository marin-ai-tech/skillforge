{
  "mcp": {
    "servers": {
      "github": {
        "type": "local",
        "command": ["npx", "-y", "@modelcontextprotocol/server-github@2025.4.8"],
        "environment": { "GITHUB_PERSONAL_ACCESS_TOKEN": "{env:GITHUB_TOKEN}" },
        "disabled": false
      },
      "remote-db": {
        "type": "remote",
        "url": "https://mcp.example.com/db",
        "headers": { "Cookie": "session=FAKE-SECRET-cookie-0001" },
        "disabled": true,
        "oauth": { "client_id": "a", "client_secret": "{env:DB_OAUTH_SECRET}" },
      },
    },
  },
}
